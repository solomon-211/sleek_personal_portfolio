// Cloudflare Worker that serves solomonleek.com (static assets, plus
// worker/index.js for video byte ranges).
// Deploy: `npx wrangler deploy`, or connect this repo under
// Workers & Pages → sleek-personal-portfolio → Settings → Builds.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sleek-personal-portfolio",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/images/*.mp4"],
    // /portfolio → /portfolio/ and serves portfolio/index.html
    "html_handling": "auto-trailing-slash",
    // Unknown paths get the custom 404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
