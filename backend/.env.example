# ══════════════════════════════════════════════════════════
#  Portfolio Contact API — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ══════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────
PORT=8000

# Comma-separated list of allowed frontend origins.
# Add your live domain when you deploy.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000,https://solomonleek.tech

# ── Rate limiting ───────────────────────────────────────────
# Max contact form submissions per IP per window
RATE_LIMIT_MAX=5
# Window size in seconds (3600 = 1 hour)
RATE_LIMIT_WINDOW=3600

# ── Admin endpoints ─────────────────────────────────────────
# Required to call /api/messages, /api/messages/count, /api/analytics/summary.
# Without this set, those endpoints return 503 (disabled) rather than leaking data.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Pass it as a request header: X-Admin-Key: <value>
ADMIN_API_KEY=

# ── Contact destination ─────────────────────────────────────
# Where to deliver messages (your inbox)
CONTACT_TO_EMAIL=s.leek@alustudent.com

# Must match SMTP_USER exactly when using Gmail — Gmail ignores custom From addresses
CONTACT_FROM_EMAIL=your-gmail@gmail.com

# ── SMTP settings ───────────────────────────────────────────
# Option A: Gmail (recommended for personal use)
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to: myaccount.google.com → Security → App Passwords
#   3. Create an App Password for "Mail"
#   4. Use that 16-character password as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=<your-16-char-app-password>
SMTP_STARTTLS=true

# Option B: Outlook / Hotmail
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-password
# SMTP_STARTTLS=true

# Option C: Custom SMTP (e.g. Zoho, SendGrid, Mailgun)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=your-email@yourdomain.com
# SMTP_PASSWORD=your-password
# SMTP_STARTTLS=true
